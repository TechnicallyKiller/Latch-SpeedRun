# ====================== Latch — Fuji testnet config ======================
# Copy this file to `.env` and fill the blanks. `.env` is gitignored.
# TESTNET ONLY. Never put a mainnet key or real funds in here.

# --- Network (defaults are correct; leave as-is) ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# --- USDC on Fuji (verified address; do not change) ---
USDC_ADDRESS=0x5425890298aed601595a70AB815c96711a31Bc65

# --- Accounts: four 0x-prefixed private keys ---
# DEPLOYER  : deploys the contracts, pays gas, relays the verdict + finalize.
#             FUND WITH: test AVAX (gas only).
DEPLOYER_PRIVATE_KEY=

# BUYER     : posts and funds the job.
#             FUND WITH: test AVAX (gas) + test USDC (>= JOB_AMOUNT below).
BUYER_PRIVATE_KEY=

# PROVIDER  : does the work and posts a bond.
#             FUND WITH: test AVAX (gas) + test USDC (>= PROVIDER_BOND below).
PROVIDER_PRIVATE_KEY=

# VERIFIER  : signs verdicts. NO FUNDING NEEDED (the deployer relays the tx).
VERIFIER_PRIVATE_KEY=

# --- Filled in automatically AFTER deploy (leave blank now) ---
LATCHJOB_ADDRESS=

# --- Evidence pinning (IPFS via Pinata) ---
# pinata.cloud -> API Keys -> New Key (Admin) -> copy the JWT (a long token).
PINATA_JWT=

# --- Demo economics (USDC has 6 decimals; defaults keep faucet funding tiny) ---
JOB_AMOUNT=5000           # 0.005 USDC
PROVIDER_BOND=1000        # 0.001 USDC
CHALLENGE_BOND=1000       # 0.001 USDC
PROTOCOL_FEE_BPS=100      # 1%
CHALLENGE_WINDOW=60       # seconds

# Optional: real Claude-powered provider agents (honest vs confidently-wrong).
# Without this, providers fall back to deterministic answers and the demo still runs.
ANTHROPIC_API_KEY=
# Free alternative (no credit card): https://console.groq.com -> API Keys. Takes priority over ANTHROPIC_API_KEY.
GROQ_API_KEY=
